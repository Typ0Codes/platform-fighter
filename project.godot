config_version=5

[GD-Sync]

version="1.0.2"

[application]

config/name="Platform Fighter"
run/main_scene="uid://bcx4nko352vfo"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GDSync="*uid://cgo4kiocg4a4a"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/GD-Sync/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/saltmire_hitbox/plugin.cfg")

